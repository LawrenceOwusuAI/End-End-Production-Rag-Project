# Dockerfile.prometheus-mcp

FROM python:3.11-slim


ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1


WORKDIR /app

RUN pip install \
    --no-cache-dir \
    --upgrade pip \
    && \
    pip install \
        --no-cache-dir \
        "mcp[cli]" \
        httpx \
        python-dotenv \
    && \
    pip install \
        --no-cache-dir \
        --upgrade \
        "setuptools>=84.0.0" \
        "wheel>=0.46.2" \
        "msgpack>=1.2.1" \
        "urllib3>=2.8.0" \
    && \
    pip check



COPY prometheus_mcp ./prometheus_mcp


EXPOSE 8001


CMD ["python","-m","prometheus_mcp.server"]