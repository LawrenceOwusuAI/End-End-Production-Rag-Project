# Dockerfile.prometheus-mcp

FROM python:3.11-slim


ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1


WORKDIR /app


RUN pip install \
    --no-cache-dir \
    --upgrade pip \
    && \
    pip install \
        --no-cache-dir \
        "mcp[cli]" \
        httpx \
        python-dotenv


COPY prometheus_mcp ./prometheus_mcp


EXPOSE 8001


CMD ["python","-m","prometheus_mcp.server"]