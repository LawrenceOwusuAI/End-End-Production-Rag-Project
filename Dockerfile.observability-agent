# Dockerfile.observability-agent

FROM python:3.11-slim


ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1


WORKDIR /app


COPY requirements.observability.txt .


RUN pip install \
    --no-cache-dir \
    --upgrade pip \
    && \
    pip install \
    --no-cache-dir \
    -r requirements.observability.txt


COPY observability_agent_api.py .
COPY llm_gateway.py .
COPY logger.py .


EXPOSE 8003


HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=20s \
    --retries=3 \
    CMD python -c \
    "import urllib.request; urllib.request.urlopen('http://localhost:8003/health')" \
    || exit 1


CMD ["uvicorn","observability_agent_api:app","--host","0.0.0.0", "--port","8003"]