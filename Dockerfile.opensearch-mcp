FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install \
    --no-cache-dir \
    --upgrade pip \
    && \
    pip install \
        --no-cache-dir \
        "mcp[cli]" \
        boto3 \
        opensearch-py \
        python-dotenv \
    && \
    pip install \
        --no-cache-dir \
        --upgrade \
        "setuptools>=84.0.0" \
        "wheel>=0.46.2" \
        "msgpack>=1.2.1" \
        "urllib3>=2.8.0" \
    && \
    pip check\
    && \
    rm -f /usr/local/lib/python3.11/site-packages/pip/_vendor/bom.cdx.json

COPY opensearch_mcp ./opensearch_mcp

EXPOSE 8002

CMD ["python","-m","opensearch_mcp.server"]