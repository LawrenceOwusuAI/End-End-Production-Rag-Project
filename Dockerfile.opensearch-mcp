FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install \
    --no-cache-dir \
    --upgrade pip \
    && \
    pip install \
        --no-cache-dir \
        "mcp[cli]" \
        boto3 \
        opensearch-py \
        python-dotenv

COPY opensearch_mcp ./opensearch_mcp

EXPOSE 8002

CMD ["python","-m","opensearch_mcp.server"]