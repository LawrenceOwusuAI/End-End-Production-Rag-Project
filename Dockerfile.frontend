
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.frontend.txt .

RUN pip install \
    --no-cache-dir \
    --upgrade pip \
    && \
    pip install \
    --no-cache-dir \
    -r requirements.frontend.txt \
    && \
    pip install \
    --no-cache-dir \
    --upgrade \
    "setuptools>=84.0.0" \
    "wheel>=0.46.2" \
    "msgpack>=1.2.1" \
    "urllib3>=2.8.0" \
    && \
    pip check

COPY streamlit_app1.py .


EXPOSE 8501

HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=20s \
    --retries=3 \
    CMD python -c \
    "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" \
    || exit 1


CMD ["streamlit","run","streamlit_app1.py","--server.address=0.0.0.0", "--server.port=8501"]